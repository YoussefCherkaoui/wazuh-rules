<!--
  Esempio di regole per il decoder in example_decoder.xml.

  Log di prova:
  Nov 19 10:00:00 server01 myapp: login failed user=mario ip=10.0.0.5
-->

<group name="myapp,local,">

  <!-- Regola base: raggruppa tutti gli eventi di myapp senza generare alert. -->
  <rule id="100000" level="0">
    <decoded_as>myapp</decoded_as>
    <description>myapp: eventi dell'applicazione.</description>
  </rule>

  <!-- Login fallito singolo. -->
  <rule id="100001" level="5">
    <if_sid>100000</if_sid>
    <field name="result">^failed$</field>
    <description>myapp: login fallito per $(dstuser) da $(srcip).</description>
    <group>authentication_failed,</group>
  </rule>

  <!-- Cinque login falliti in due minuti dallo stesso IP: possibile forza bruta. -->
  <rule id="100002" level="10" frequency="5" timeframe="120">
    <if_matched_sid>100001</if_matched_sid>
    <same_srcip />
    <description>myapp: 5 login falliti in 2 minuti da $(srcip), possibile forza bruta.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

</group>

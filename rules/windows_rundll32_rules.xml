<!--
  Windows - rundll32 opening a URL, with an exception for NetBird
  ID block: 100900-100999

  100974  rundll32 url.dll,FileProtocolHandler opening an http(s) URL
          (Windows Security event 4688 - process creation). Technique
          often abused to launch content through a trusted Windows binary.

  100979  Exception: the NetBird client opens its update page in the
          browser this way. Known false positive, lowered to level 3
          only when BOTH conditions are true:
          - the parent is C:\Program Files\NetBird\netbird-ui.exe
            (full path anchored: matching only the file name would let a
            netbird-ui.exe dropped in %TEMP% hide the alert);
          - the command line opens exactly https://pkgs.netbird.io/windows/
            (anchored with ^, so a URL that only contains the domain in
            its path does not slip through).
          Same command from any other process, or to any other address,
          stays a level 12 alert.
          Added: 2026-11-25. Source event: examples/netbird_rundll32_update_event.json

  Requirements:
  - Windows "Audit Process Creation" enabled
  - "Include command line in process creation events" enabled
    (otherwise win.eventdata.commandLine is empty and 100974 never fires)
-->

<group name="windows,custom,rundll32,">

  <rule id="100974" level="12">
    <decoded_as>windows_eventchannel</decoded_as>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\rundll32\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)url\.dll\s*,\s*FileProtocolHandler\s+https?://</field>
    <description>rundll32 url.dll,FileProtocolHandler opened a URL (possible proxy execution)</description>
    <mitre>
      <id>T1218.011</id>
    </mitre>
  </rule>

  <rule id="100979" level="3">
    <if_sid>100974</if_sid>
    <field name="win.eventdata.parentProcessName" type="pcre2">(?i)^C:\\+Program Files\\+NetBird\\+netbird-ui\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)^rundll32(\.exe)?\s+url\.dll,FileProtocolHandler\s+https://pkgs\.netbird\.io/windows/</field>
    <description>NetBird: update page opened in the browser (known false positive)</description>
  </rule>

</group>

